+// Serpantinum: какая кнопка (стиль windows) под курсором; -1 — никакая. Кнопки справа налево, во всю высоту.
+int CHyprBar::windowsButtonAt(const Vector2D& coords) {
+    const auto HEIGHT = g_pGlobalState->config.barHeight->value();
+    const auto W      = assignedBoxGlobal().w;
+    if (coords.y < 0 || coords.y >= HEIGHT)
+        return -1;
+    float right = W;
+    for (size_t i = 0; i < g_pGlobalState->buttons.size(); ++i) {
+        const auto& b = g_pGlobalState->buttons[i];
+        if (coords.x >= right - b.size && coords.x < right)
+            return (int)i;
+        right -= b.size;
+    }
+    return -1;
+}
