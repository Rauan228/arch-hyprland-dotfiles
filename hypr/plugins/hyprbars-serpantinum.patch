+// ---------- Serpantinum: прилипание окон при перетаскивании (Aero Snap) ----------
+// Пока окно тащат (любым способом), смотрим, где курсор: у внешнего края монитора → зона.
+// Смена зоны → `<snap_command> preview <зона> <монитор>`, отпустили в зоне → `<snap_command> drop <зона> <монитор> <окно>`.
+// Зоны: left, right, max (верх), tl, tr, bl, br (углы). Края между мониторами зонами не считаются.
+static std::string g_snapZone, g_snapMon, g_snapWin;
+static bool        g_snapDragging = false;
+
+static bool pointOnAnyMonitor(const Vector2D& p) {
+    for (auto& m : State::monitorState()->monitors())
+        if (m->logicalBox().containsPoint(p))
+            return true;
+    return false;
+}
+
+static std::string snapZoneAt(const Vector2D& c, std::string& monName) {
+    for (auto& m : State::monitorState()->monitors()) {
+        const auto box = m->logicalBox();
+        if (!box.containsPoint(c))
+            continue;
+        monName           = m->m_name;
+        const double T    = 3;    // насколько близко к краю
+        const double C    = 100;  // размер угловой зоны
+        const bool   outL = !pointOnAnyMonitor({box.x - 4, c.y}), outR = !pointOnAnyMonitor({box.x + box.w + 4, c.y});
+        const bool   outT = !pointOnAnyMonitor({c.x, box.y - 4}), outB = !pointOnAnyMonitor({c.x, box.y + box.h + 4});
+        const bool   l = outL && c.x <= box.x + T, r = outR && c.x >= box.x + box.w - 1 - T;
+        const bool   t = outT && c.y <= box.y + T, b = outB && c.y >= box.y + box.h - 1 - T;
+        const bool   nl = c.x <= box.x + C, nr = c.x >= box.x + box.w - C, nt = c.y <= box.y + C, nb = c.y >= box.y + box.h - C;
+        if ((l && nt) || (t && nl && outL)) return "tl";
+        if ((r && nt) || (t && nr && outR)) return "tr";
+        if ((l && nb) || (b && nl && outL)) return "bl";
+        if ((r && nb) || (b && nr && outR)) return "br";
+        if (l) return "left";
+        if (r) return "right";
+        if (t) return "max";
+        return "";
+    }
+    return "";
+}
+
+static void snapRun(const std::string& args) {
+    const auto CMD = g_pGlobalState->config.snapCommand->value();
+    if (!CMD.empty())
+        Config::Supplementary::executor()->spawn(CMD + " " + args);
+}
+
+static void snapOnMouseMove(const Vector2D& coords) {
+    if (g_pGlobalState->config.snapCommand->value().empty())
+        return;
+    const auto& DRAG = g_layoutManager->dragController();
+    if (!DRAG || DRAG->mode() != MBIND_MOVE || !DRAG->target() || !DRAG->target()->window()) {
+        return;
+    }
+    const auto PWINDOW = DRAG->target()->window();
+    g_snapDragging     = true;
+    g_snapWin          = std::format("0x{:x}", (uintptr_t)PWINDOW.get());
+    std::string mon;
+    const auto  zone = snapZoneAt(g_pInputManager->getMouseCoordsInternal(), mon);
+    if (zone != g_snapZone || (!zone.empty() && mon != g_snapMon)) {
+        g_snapZone = zone;
+        g_snapMon  = mon;
+        snapRun("preview " + (zone.empty() ? std::string("none") : zone) + " " + (mon.empty() ? std::string("-") : mon));
+    }
+}
+
+static void snapOnMouseButton(IPointer::SButtonEvent e) {
+    if (e.state == WL_POINTER_BUTTON_STATE_PRESSED || !g_snapDragging)
+        return;
+    if (!g_snapZone.empty())
+        snapRun("drop " + g_snapZone + " " + g_snapMon + " " + g_snapWin);
+    else
+        snapRun("preview none -");
+    g_snapDragging = false;
+    g_snapZone.clear();
+    g_snapMon.clear();
+    g_snapWin.clear();
+}
