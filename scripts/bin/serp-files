#!/usr/bin/env bash
# serp-files [путь | file://URI] — открыть «Диспетчер файлов» Serpantinum.
# Если передан файл, а не папка — открывается его папка и файл выделяется.
main="$HOME/.local/share/serpantinum/runtime/quickshell/Shell.qml"
p="${1:-}"
case "$p" in
  file://*) p=$(python3 -c 'import sys, urllib.parse; print(urllib.parse.unquote(urllib.parse.urlparse(sys.argv[1]).path))' "$p") ;;
esac
[ -n "$p" ] && p=$(realpath -m -- "$p")
if [ -n "$p" ] && [ -e "$p" ] && [ ! -d "$p" ]; then
  exec quickshell -p "$main" ipc call files reveal "$p"
fi
exec quickshell -p "$main" ipc call files open "$p"
