#!/usr/bin/env bash
# serp-minall all | others | restore — как Win+M / Win+Home / Win+Shift+M в Windows:
# свернуть все окна текущего рабочего стола (или все, кроме активного) и вернуть их обратно.
# Сворачивает и возвращает serp-win (QUIET=1 — без анимации каждого окна): окна запоминают место и стол,
# поэтому потом их можно вернуть и по одному — кликом в доке или через Alt+Tab.
set -u
here="$(dirname "$(readlink -f "$0")")"
state="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/serpantinum/minall"; mkdir -p "$(dirname "$state")"
cur=$(hyprctl activeworkspace -j | jq -r '.id % 100')
act=$(hyprctl activewindow -j | jq -r '.address // empty')
case "${1:-all}" in
  all|others)
    : > "$state"
    for a in $(hyprctl clients -j | jq -r --argjson c "$cur" '.[] | select(.mapped and .workspace.id > 0 and (.workspace.id % 100) == $c) | .address'); do
      [ "$1" = others ] && [ "$a" = "$act" ] && continue
      echo "$a" >> "$state"
      QUIET=1 "$here/serp-win" min "$a"
    done
    if [ "$1" = others ] && [ -n "$act" ]; then
      hyprctl dispatch "hl.dsp.focus({ window = \"address:$act\" })" >/dev/null
    else
      hyprctl dispatch "hl.dsp.focus({ workspace = \"$(hyprctl activeworkspace -j | jq -r '.id')\" })" >/dev/null
    fi ;;
  restore)
    [ -f "$state" ] || exit 0
    last=""
    while read -r a _; do
      hyprctl clients -j | jq -e --arg a "$a" 'any(.[]; .address == $a and .workspace.id < 0)' >/dev/null || continue
      QUIET=1 "$here/serp-win" restore "$a"; last=$a
    done < "$state"
    rm -f "$state"
    [ -n "$last" ] && hyprctl dispatch "hl.dsp.focus({ window = \"address:$last\" })" >/dev/null ;;
esac
