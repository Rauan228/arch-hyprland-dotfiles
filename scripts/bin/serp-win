#!/usr/bin/env bash
# serp-win <min|restore|max|close|special> [монитор | 0xADDR] — действия с окном (кнопки заголовка, панель, док).
# Окно: 0xADDR — это окно; имя монитора — последнее сфокусированное окно на его рабочем столе; иначе — активное.
#   min      свернуть как в Windows: окно уходит в скрытый special:minimized, запоминается, с какого
#            рабочего стола оно ушло, а фокус переходит на следующее окно под ним (а не остаётся на невидимом)
#   restore  вернуть свёрнутое туда же, откуда свернули (тот же стол и место), поверх остальных и с фокусом
set -euo pipefail
act="${1:-}"; arg="${2:-}"; arg="${arg#address:}"   # принимаем и 0xADDR, и address:0xADDR
state="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/serpantinum/minimized"; mkdir -p "$state"
d() { hyprctl dispatch "$1" >/dev/null; }

# special МОНИТОР — оболочка зовёт, когда на мониторе сам открылся скрытый стол свёрнутых окон
# (программа попросила фокус: Telegram/VS Code делают это сразу после своего «─» или по уведомлению).
# Стол свёрнутых никогда не показываем: только что свёрнутое (< 2 с) остаётся свёрнутым,
# а позже активированное (клик по уведомлению) возвращаем на своё место.
if [ "$act" = special ]; then
  read -r a wsn < <(hyprctl activewindow -j | jq -r '"\(.address // "") \(.workspace.name // "")"')
  f="$state/$a"
  if [ -n "$a" ] && [ "$wsn" = special:minimized ] && { [ ! -e "$f" ] || [ $(( $(date +%s) - $(stat -c %Y "$f") )) -ge 2 ]; }; then
    exec "$0" restore "$a"
  fi
  d "hl.dsp.focus({ monitor = \"$arg\" })"
  d 'hl.dsp.workspace.toggle_special("minimized")'
  ws=$(hyprctl monitors -j | jq -r --arg m "$arg" '.[] | select(.name == $m) | .activeWorkspace.id')
  next=$(hyprctl clients -j | jq -r --argjson ws "${ws:-0}" '[.[] | select(.workspace.id == $ws and .mapped and (.hidden | not))]
                                                         | sort_by(.focusHistoryID) | .[0].address // empty')
  [ -n "$next" ] && d "hl.dsp.focus({ window = \"address:$next\" })"
  exit 0
fi

clients=$(hyprctl clients -j)
case "$arg" in
  0x*) addr="$arg" ;;
  ?*)  ws=$(hyprctl monitors -j | jq -r --arg m "$arg" '.[] | select(.name == $m) | .activeWorkspace.id')
       [ -n "$ws" ] || exit 1
       addr=$(jq -r --argjson ws "$ws" '[.[] | select(.workspace.id == $ws and .mapped and (.hidden | not))]
                                        | sort_by(.focusHistoryID) | .[0].address // empty' <<<"$clients") ;;
  *)   addr=$(hyprctl activewindow -j | jq -r '.address // empty') ;;
esac
[ -n "$addr" ] || exit 0
w="address:$addr"

# анимация «засасывания» в док: на время свернуть/вернуть движение и прозрачность окна идут по своим кривым
# (serpMinIn/serpMinOut из hypr/modules/animations.lua), потом возвращаются обычные — как в animations.lua
ANIM=0.36
anim() {   # in | out | off | default
  case "$1" in
    in|out) local c=serpMin${1^}
            hyprctl --batch "eval hl.animation({ leaf = 'windowsMove', enabled = true, speed = 3.5, bezier = '$c' }) ; eval hl.animation({ leaf = 'fadeSwitch', enabled = true, speed = 3.5, bezier = '$c' })" >/dev/null ;;
    off)    hyprctl --batch "eval hl.animation({ leaf = 'windowsMove', enabled = false }) ; eval hl.animation({ leaf = 'fadeSwitch', enabled = false })" >/dev/null ;;
    default) hyprctl --batch "eval hl.animation({ leaf = 'windowsMove', enabled = true, speed = 4.79, spring = 'easy' }) ; eval hl.animation({ leaf = 'fadeSwitch', enabled = true, speed = 3.03, bezier = 'quick' })" >/dev/null ;;
  esac
}
geom() {   # addr x y w h [opacity]
  local b="dispatch hl.dsp.window.resize({ x = $4, y = $5, window = \"address:$1\" }) ; dispatch hl.dsp.window.move({ x = $2, y = $3, window = \"address:$1\" })"
  [ -n "${6:-}" ] && b="$b ; dispatch hl.dsp.window.set_prop({ prop = \"opacity\", value = \"$6\", window = \"address:$1\" })"
  hyprctl --batch "$b" >/dev/null
}

minimize() {
  local ws x y ww hh mon op mx my mw mh tw th tx ty next
  read -r ws x y ww hh mon < <(jq -r --arg a "$addr" '.[] | select(.address == $a) | "\(.workspace.id) \(.at[0]) \(.at[1]) \(.size[0]) \(.size[1]) \(.monitor)"' <<<"$clients")
  [ -n "${ws:-}" ] || return 0
  [ "$ws" -lt 0 ] && return 0                                    # уже свёрнуто
  op=$(hyprctl getprop "$w" opacity -j 2>/dev/null | jq -r '.opacity // 1' 2>/dev/null); op=${op:-1}
  # куда «засасывать»: док — середина нижнего края монитора окна
  read -r mx my mw mh < <(hyprctl monitors -j | jq -r --argjson m "$mon" '.[] | select(.id == $m) | "\(.x) \(.y) \((.width / .scale) | floor) \((.height / .scale) | floor)"')
  tw=$(( ww / 8 > 48 ? ww / 8 : 48 )); th=$(( hh / 8 > 32 ? hh / 8 : 32 ))
  tx=$(( mx + mw / 2 - tw / 2 )); ty=$(( my + mh - th - 6 ))
  echo "$ws $x $y $ww $hh $op $tx $ty $tw $th" > "$state/$addr"
  # следующее окно на том же столе (по истории фокуса) — получит фокус, как в Windows
  next=$(jq -r --arg a "$addr" --argjson ws "$ws" '[.[] | select(.address != $a and .workspace.id == $ws and .mapped and (.hidden | not))]
                                                   | sort_by(.focusHistoryID) | .[0].address // empty' <<<"$clients")
  anim in; geom "$addr" "$tx" "$ty" "$tw" "$th" 0; sleep "$ANIM"
  # фокус отдаём ДО переноса: иначе Hyprland сам ищет, кому отдать фокус, берёт уже свёрнутое окно
  # из истории, открывает скрытый стол — и на мгновение мелькают свёрнутые окна
  if [ -n "$next" ]; then
    d "hl.dsp.focus({ window = \"address:$next\" })"
  else
    d "hl.dsp.focus({ workspace = \"$ws\" })"                     # стол пуст — снять фокус с невидимого окна
  fi
  d "hl.dsp.window.move({ workspace = \"special:minimized\", window = \"$w\", silent = true })"
  anim default
}

restore() {
  local ws="" x="" y="" ww="" hh="" op="" tx="" ty="" tw="" th="" mx
  read -r ws x y ww hh op tx ty tw th < "$state/$addr" 2>/dev/null || true
  # стол, с которого свернули, — если он ещё есть; иначе текущий
  if [ -z "$ws" ] || ! hyprctl workspaces -j | jq -e --argjson ws "$ws" 'any(.[]; .id == $ws)' >/dev/null; then
    ws=$(hyprctl activeworkspace -j | jq -r '.id')
  fi
  # развёрнутому обновляем отметку, чтобы serp-maxwatch не принял возврат за перетаскивание
  mx="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/serpantinum/maxed/$addr"
  [ -f "$mx" ] && touch "$mx"
  if [ -n "$tx" ]; then
    # мгновенно поставить крошечным и прозрачным у дока, затем «вылететь» на прежнее место и в прежний размер
    anim off
    d "hl.dsp.window.move({ workspace = \"$ws\", window = \"$w\" })"
    geom "$addr" "$tx" "$ty" "$tw" "$th" 0
    d "hl.dsp.focus({ window = \"$w\" })"
    d "hl.dsp.window.alter_zorder({ mode = \"top\", window = \"$w\" })"
    sleep 0.03
    anim out; geom "$addr" "$x" "$y" "$ww" "$hh" "${op:-1}"; sleep "$ANIM"
    anim default
  else
    # свёрнуто до этой версии (без записи) — просто вернуть
    d "hl.dsp.window.move({ workspace = \"$ws\", window = \"$w\" })"
    [ -n "$x" ] && geom "$addr" "$x" "$y" "$ww" "$hh"
    d "hl.dsp.focus({ window = \"$w\" })"
    d "hl.dsp.window.alter_zorder({ mode = \"top\", window = \"$w\" })"
  fi
  rm -f "$state/$addr"
}

case "$act" in
  min)     minimize ;;
  restore) restore ;;
  max)     exec "$(dirname "$0")/serp-max" toggle "$addr" ;;     # развернуть как в Windows (окно остаётся плавающим)
  close)   d "hl.dsp.window.close({ window = \"$w\" })" ;;
  *) echo "usage: serp-win min|restore|max|close [monitor|0xADDR]" >&2; exit 2 ;;
esac
