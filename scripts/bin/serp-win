#!/usr/bin/env bash
# serp-win <min|restore|focus|max|close|special|taskbar|clients> [монитор | 0xADDR] — действия с окном (кнопки заголовка, панель, док).
# Окно: 0xADDR — это окно; имя монитора — последнее сфокусированное окно на его рабочем столе; иначе — активное.
#   min      свернуть как в Windows: окно уходит в скрытый special:minimized, запоминается, с какого
#            рабочего стола оно ушло, а фокус переходит на следующее окно под ним (а не остаётся на невидимом)
#   restore  вернуть свёрнутое туда же, откуда свернули (тот же стол и место), поверх остальных и с фокусом
#   clients  окна для Alt+Tab: как `hyprctl clients -j`, у свёрнутых ещё minDesk — с какого стола свернули
#   QUIET=1 serp-win min|restore ADDR — без анимации и без смены фокуса (Win+M / Win+Shift+M — serp-minall)
#   taskbar ADDR... — клик по значку приложения в доке (все окна этого приложения), как в Windows:
#            окна текущего рабочего стола (и свёрнутые с него): одно активное — свернуть; несколько и одно из них
#            активно — следующее; иначе — последнее использованное (свёрнутое разворачивается);
#            на этом столе окон нет — перейти к последнему использованному на другом столе
#   focus    открыть окно как кликом по панели задач Windows: свёрнутое — развернуть, на другом рабочем столе —
#            сначала переключить стол целиком (на всех мониторах, serp-desk), затем фокус и поверх остальных
set -euo pipefail
act="${1:-}"; arg="${2:-}"; arg="${arg#address:}"   # принимаем и 0xADDR, и address:0xADDR
state="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/serpantinum/minimized"; mkdir -p "$state"
d() { hyprctl dispatch "$1" >/dev/null; }
# special МОНИТОР — оболочка зовёт, когда на мониторе сам открылся скрытый стол свёрнутых окон
# (Hyprland отдал фокус свёрнутому окну или программа попросила фокус — Telegram/VS Code после своего «─»).
# Стол свёрнутых никогда не показываем и окна сами не возвращаем: только закрыть стол и вернуть фокус.
# Свёрнутые окна стоят за пределами экранов, так что даже мгновенное открытие стола ничего не показывает.
if [ "$act" = special ]; then
  # Hyprland сам на миг «открывает и закрывает» скрытый стол при каждом переносе окна туда. Закрываем, только
  # если стол ещё открыт: toggle по уже закрытому столу открыл бы его снова (и Hyprland втянул бы окна на экран)
  if hyprctl monitors -j | jq -e --arg m "$arg" 'any(.[]; .name == $m and .specialWorkspace.name == "special:minimized")' >/dev/null; then
    d "hl.dsp.focus({ monitor = \"$arg\" })"
    d 'hl.dsp.workspace.toggle_special("minimized")'
  fi
  # фокус меняем, только если он оказался на свёрнутом окне
  hyprctl activewindow -j | jq -e '.workspace.name == "special:minimized"' >/dev/null || exit 0
  ws=$(hyprctl monitors -j | jq -r --arg m "$arg" '.[] | select(.name == $m) | .activeWorkspace.id')
  next=$(hyprctl clients -j | jq -r --argjson ws "${ws:-0}" '[.[] | select(.workspace.id == $ws and .mapped and (.hidden | not))]
                                                         | sort_by(.focusHistoryID) | .[0].address // empty')
  if [ -z "$next" ]; then   # на этом мониторе окон нет — последнее окно текущего стола на любом мониторе
    next=$(hyprctl clients -j | jq -r --argjson d "$(( ${ws:-1} % 100 ))" '[.[] | select(.workspace.id > 0 and .workspace.id % 100 == $d and .mapped)]
                                                                   | sort_by(.focusHistoryID) | .[0].address // empty')
  fi
  [ -n "$next" ] && d "hl.dsp.focus({ window = \"address:$next\" })"
  exit 0
fi

if [ "$act" = clients ]; then
  mini='{}'
  for f in "$state"/0x*; do
    [ -e "$f" ] || continue
    read -r mws _ < "$f" || continue
    mini=$(jq -c --arg a "$(basename "$f")" --argjson d "$(( ${mws:-1} % 100 ))" '. + {($a): $d}' <<<"$mini")
  done
  hyprctl clients -j | jq -c --argjson m "$mini" 'map(if .workspace.id < 0 and $m[.address] then . + {minDesk: $m[.address]} else . end)'
  exit 0
fi

# Действия над окнами — строго по очереди: двойной клик/касание по доку запускал две команды сразу —
# вторая сворачивала окно посреди анимации разворота и запоминала его промежуточное место (под экраном)
# и прозрачность 0; потом окно разворачивалось невидимым «на другом мониторе». Вложенные вызовы
# (taskbar → focus → restore через exec) уже держат блокировку — SERP_WIN_LOCKED.
if [ -z "${SERP_WIN_LOCKED:-}" ]; then
  exec 9>"${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/serpantinum/serp-win.lock"
  flock -w 5 9 || exit 0
  export SERP_WIN_LOCKED=1
fi

if [ "$act" = taskbar ]; then
  shift
  clients=$(hyprctl clients -j)
  active=$(hyprctl activewindow -j | jq -r '.address // empty')
  id=$(hyprctl activeworkspace -j | jq -r '.id'); desk=1; [ "$id" -gt 0 ] 2>/dev/null && desk=$(( id % 100 ))
  # окна приложения: адрес, стол (для свёрнутых — откуда свернули), свёрнуто ли, порядок открытия, давность фокуса
  rows=""
  for a in "$@"; do
    a="${a#address:}"; a="0x${a#0x}"
    r=$(jq -r --arg a "$a" '.[] | select(.address == $a) | "\(.workspace.id) \(.stableId) \(.focusHistoryID)"' <<<"$clients")
    [ -n "$r" ] || continue
    read -r ws sid fh <<<"$r"
    if [ "$ws" -lt 0 ]; then
      mws=$(cut -d' ' -f1 "$state/$a" 2>/dev/null || echo "$id"); wd=$(( ${mws:-1} % 100 )); m=1
    else
      wd=$(( ws % 100 )); m=0
    fi
    rows+="$a $wd $m $((16#$sid)) $fh"$'\n'
  done
  [ -n "$rows" ] || exit 0
  here=$(awk -v d="$desk" '$2 == d' <<<"$rows")
  if [ -z "$here" ]; then                                         # на этом столе нет — к последнему на другом
    exec "$0" focus "$(sort -k5 -n <<<"$rows" | head -1 | cut -d' ' -f1)"
  fi
  n=$(grep -c . <<<"$here")
  if awk -v a="$active" '$1 == a && $3 == 0 {f=1} END {exit !f}' <<<"$here"; then
    [ "$n" -eq 1 ] && exec "$0" min "$active"                    # единственное и активное — свернуть
    # несколько — следующее по порядку открытия (как перебор окон группы на панели задач)
    t=$(sort -k4 -n <<<"$here" | awk -v a="$active" '{l[NR]=$1; if ($1 == a) i=NR} END {print l[i % NR + 1]}')
    exec "$0" focus "$t"
  fi
  exec "$0" focus "$(sort -k5 -n <<<"$here" | head -1 | cut -d' ' -f1)"   # последнее использованное
fi

clients=$(hyprctl clients -j)
case "$arg" in
  0x*) addr="$arg" ;;
  ?*)  ws=$(hyprctl monitors -j | jq -r --arg m "$arg" '.[] | select(.name == $m) | .activeWorkspace.id')
       [ -n "$ws" ] || exit 1
       addr=$(jq -r --argjson ws "$ws" '[.[] | select(.workspace.id == $ws and .mapped and (.hidden | not))]
                                        | sort_by(.focusHistoryID) | .[0].address // empty' <<<"$clients") ;;
  *)   addr=$(hyprctl activewindow -j | jq -r '.address // empty') ;;
esac
[ -n "$addr" ] || exit 0
w="address:$addr"

# анимация «засасывания» в док: на время свернуть/вернуть движение и прозрачность окна идут по своим кривым
# (serpMinIn/serpMinOut из hypr/modules/animations.lua), потом возвращаются обычные — как в animations.lua
ANIM=0.36
OFF_DY=3000  # «за экраном»: свёрнутые окна стоят далеко ПОД своим монитором. Не в дальнем углу (-30000):
             # оттуда Hyprland считал окно окном другого монитора и переносил туда фокус — фокус прыгал
anim() {   # in | out | off | default
  case "$1" in
    in|out) local c=serpMin${1^}
            hyprctl --batch "eval hl.animation({ leaf = 'windowsMove', enabled = true, speed = 3.5, bezier = '$c' }) ; eval hl.animation({ leaf = 'fadeSwitch', enabled = true, speed = 3.5, bezier = '$c' })" >/dev/null ;;
    off)    hyprctl --batch "eval hl.animation({ leaf = 'windowsMove', enabled = false }) ; eval hl.animation({ leaf = 'fadeSwitch', enabled = false })" >/dev/null ;;
    default) hyprctl --batch "eval hl.animation({ leaf = 'windowsMove', enabled = true, speed = 4.79, spring = 'easy' }) ; eval hl.animation({ leaf = 'fadeSwitch', enabled = true, speed = 3.03, bezier = 'quick' })" >/dev/null ;;
  esac
}
geom() {   # addr x y w h [opacity]
  local b="dispatch hl.dsp.window.resize({ x = $4, y = $5, window = \"address:$1\" }) ; dispatch hl.dsp.window.move({ x = $2, y = $3, window = \"address:$1\" })"
  [ -n "${6:-}" ] && b="$b ; dispatch hl.dsp.window.set_prop({ prop = \"opacity\", value = \"$6\", window = \"address:$1\" })"
  hyprctl --batch "$b" >/dev/null
}
park() {   # addr x y — поставить свёрнутое окно за экран и убедиться, что оно там (Hyprland переносит окно
           # на скрытый стол в следующем кадре и может пересчитать координаты уже после нашей команды)
  local i cy
  for i in 1 2 3 4 5; do
    hyprctl dispatch "hl.dsp.window.move({ x = $2, y = $3, window = \"address:$1\" })" >/dev/null
    sleep 0.04
    cy=$(hyprctl clients -j | jq -r --arg a "$1" '.[] | select(.address == $a) | .at[1]')
    [ "${cy:-0}" -ge $(( $3 - 10 )) ] && return 0
  done
}
slide() {  # addr x y [opacity] — только сдвиг (и прозрачность), БЕЗ изменения размера: программа не перерисовывается
  local b="dispatch hl.dsp.window.move({ x = $2, y = $3, window = \"address:$1\" })"
  [ -n "${4:-}" ] && b="$b ; dispatch hl.dsp.window.set_prop({ prop = \"opacity\", value = \"$4\", window = \"address:$1\" })"
  hyprctl --batch "$b" >/dev/null
}

# рабочий стол = номер рабочего пространства % 100 (на каждом мониторе своё: 1, 101, 201… — scripts/bin/serp-desk)
cur_desk() { local id; id=$(hyprctl activeworkspace -j | jq -r '.id'); [ "$id" -gt 0 ] 2>/dev/null && echo $(( id % 100 )) || echo 1; }
goto_desk() {   # переключить стол на всех мониторах сразу, если окно не на текущем (иначе мониторы «расходятся»)
  local n=$(( $1 % 100 ))
  [ "$1" -gt 0 ] 2>/dev/null && [ "$n" -ge 1 ] && [ "$n" != "$(cur_desk)" ] && "$(dirname "$0")/serp-desk" go "$n"
  return 0
}

minimize() {
  local ws x y ww hh mon op mx my mw mh tw th tx ty next
  read -r ws x y ww hh mon < <(jq -r --arg a "$addr" '.[] | select(.address == $a) | "\(.workspace.id) \(.at[0]) \(.at[1]) \(.size[0]) \(.size[1]) \(.monitor)"' <<<"$clients")
  [ -n "${ws:-}" ] || return 0
  [ "$ws" -lt 0 ] && return 0                                    # уже свёрнуто
  op=$(hyprctl getprop "$w" opacity -j 2>/dev/null | jq -r '.opacity // 1' 2>/dev/null); op=${op:-1}
  awk -v o="$op" 'BEGIN { exit !(o < 0.2) }' && op=1                 # «невидимую» прозрачность не запоминаем
  # куда «засасывать»: в док — окно уезжает к середине нижнего края монитора и уходит под него, растворяясь.
  # Размер окна не меняем: если сжимать, Chrome/VS Code/Telegram перерисовывают интерфейс под крошечный размер
  # и на долю секунды видно их «сломанную» вёрстку
  read -r mx my mw mh < <(hyprctl monitors -j | jq -r --argjson m "$mon" '.[] | select(.id == $m) | "\(.x) \(.y) \((.width / .scale) | floor) \((.height / .scale) | floor)"')
  tw=$ww; th=$hh
  tx=$(( mx + mw / 2 - ww / 2 )); ty=$(( my + mh + 20 ))
  echo "$ws $x $y $ww $hh $op $tx $ty $tw $th" > "$state/$addr"
  # свёрнутое окно Hyprland сам не выбирает для фокуса (иначе он открывал скрытый стол и втягивал окна на экран)
  d "hl.dsp.window.set_prop({ prop = \"no_focus\", value = \"1\", window = \"$w\" })"
  if [ "${QUIET:-0}" = 1 ]; then                                  # Win+M: сразу за экран, фокус не трогаем
    anim off; slide "$addr" "$tx" "$(( my + mh + OFF_DY ))" 0
    d "hl.dsp.window.move({ workspace = \"special:minimized\", window = \"$w\", silent = true })"
    park "$addr" "$tx" "$(( my + mh + OFF_DY ))"; anim default
    return 0
  fi
  # следующее окно на том же столе (по истории фокуса) — получит фокус, как в Windows
  next=$(jq -r --arg a "$addr" --argjson ws "$ws" '[.[] | select(.address != $a and .workspace.id == $ws and .mapped and (.hidden | not))]
                                                   | sort_by(.focusHistoryID) | .[0].address // empty' <<<"$clients")
  anim in; slide "$addr" "$tx" "$ty" 0; sleep "$ANIM"
  # фокус отдаём ДО переноса: иначе Hyprland сам ищет, кому отдать фокус, берёт уже свёрнутое окно
  # из истории, открывает скрытый стол — и на мгновение мелькают свёрнутые окна
  # (стол пуст — фокус никому: как в Windows; свёрнутое окно с no_focus Hyprland сам с фокуса снимает)
  [ -n "$next" ] && d "hl.dsp.focus({ window = \"address:$next\" })"
  # за пределы всех экранов (мгновенно) — тогда скрытый стол, даже если Hyprland на миг его покажет, пуст
  anim off
  slide "$addr" "$tx" "$(( my + mh + OFF_DY ))"
  d "hl.dsp.window.move({ workspace = \"special:minimized\", window = \"$w\", silent = true })"
  park "$addr" "$tx" "$(( my + mh + OFF_DY ))"
  anim default
}

restore() {
  local ws="" x="" y="" ww="" hh="" op="" tx="" ty="" tw="" th="" mx
  read -r ws x y ww hh op tx ty tw th < "$state/$addr" 2>/dev/null || true
  # окно свернули на другом рабочем столе — сначала переключить стол целиком (все мониторы)
  [ -n "$ws" ] && goto_desk "$ws"
  # стол, с которого свернули, — если он ещё есть; иначе текущий
  if [ -z "$ws" ] || ! hyprctl workspaces -j | jq -e --argjson ws "$ws" 'any(.[]; .id == $ws)' >/dev/null; then
    ws=$(hyprctl activeworkspace -j | jq -r '.id')
  fi
  d "hl.dsp.window.set_prop({ prop = \"no_focus\", value = \"0\", window = \"$w\" })"
  # запомненное место вне всех мониторов (испорченная запись) — по центру того монитора, где окно было
  if [ -n "$x" ] && ! hyprctl monitors -j | jq -e --argjson x "$x" --argjson y "$y" --argjson w "$ww" --argjson h "$hh" \
       'any(.[]; ($x + $w / 2) >= .x and ($x + $w / 2) < .x + .width / .scale and ($y + $h / 2) >= .y and ($y + $h / 2) < .y + .height / .scale)' >/dev/null; then
    read -r x y < <(hyprctl monitors -j | jq -r --argjson tx "${tx:-0}" --argjson w "$ww" --argjson h "$hh" '
      (map(select($tx >= .x and $tx < .x + .width / .scale)) + .)[0] | "\(.x + ((.width / .scale - $w) / 2 | floor)) \(.y + ((.height / .scale - $h) / 2 | floor))"')
  fi
  [ -n "$op" ] && awk -v o="$op" 'BEGIN { exit !(o < 0.2) }' && op=1
  # развёрнутому обновляем отметку, чтобы serp-maxwatch не принял возврат за перетаскивание
  mx="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/serpantinum/maxed/$addr"
  [ -f "$mx" ] && touch "$mx"
  if [ -n "$tx" ] && [ "${QUIET:-0}" = 1 ]; then                 # Win+Shift+M: сразу на место, без анимации
    anim off
    d "hl.dsp.window.move({ workspace = \"$ws\", window = \"$w\", silent = true })"
    geom "$addr" "$x" "$y" "$ww" "$hh" "${op:-1}"
    anim default
  elif [ -n "$tx" ]; then
    # мгновенно поставить прозрачным под доком, затем «вылететь» на прежнее место (размер не трогаем —
    # он и так прежний, программа ничего не перерисовывает)
    anim off
    d "hl.dsp.window.move({ workspace = \"$ws\", window = \"$w\" })"
    # свёрнутое прежней версией (сжатием) — сначала вернуть размер, пока окно невидимо
    if ! hyprctl clients -j | jq -e --arg a "$addr" --argjson w "$ww" --argjson h "$hh" 'any(.[]; .address == $a and .size == [$w, $h])' >/dev/null; then
      geom "$addr" "$tx" "$ty" "$ww" "$hh" 0
    fi
    slide "$addr" "$tx" "$ty" 0
    d "hl.dsp.focus({ window = \"$w\" })"
    d "hl.dsp.window.alter_zorder({ mode = \"top\", window = \"$w\" })"
    sleep 0.03
    anim out; slide "$addr" "$x" "$y" "${op:-1}"; sleep "$ANIM"
    anim default
  else
    # свёрнуто до этой версии (без записи) — просто вернуть
    d "hl.dsp.window.move({ workspace = \"$ws\", window = \"$w\" })"
    if [ -n "$x" ]; then geom "$addr" "$x" "$y" "$ww" "$hh"; else d "hl.dsp.window.center({ window = \"$w\" })"; fi
    d "hl.dsp.focus({ window = \"$w\" })"
    d "hl.dsp.window.alter_zorder({ mode = \"top\", window = \"$w\" })"
  fi
  rm -f "$state/$addr"
}

focus_win() {
  local ws
  ws=$(jq -r --arg a "$addr" '.[] | select(.address == $a) | .workspace.id' <<<"$clients")
  [ -n "$ws" ] || return 0
  if [ "$ws" -lt 0 ]; then restore; return; fi                   # свёрнуто — развернуть
  goto_desk "$ws"
  d "hl.dsp.focus({ window = \"$w\" })"
  d "hl.dsp.window.alter_zorder({ mode = \"top\", window = \"$w\" })"
}

case "$act" in
  min)     minimize ;;
  restore) restore ;;
  focus)   focus_win ;;
  max)     exec "$(dirname "$0")/serp-max" toggle "$addr" ;;     # развернуть как в Windows (окно остаётся плавающим)
  close)   d "hl.dsp.window.close({ window = \"$w\" })" ;;
  *) echo "usage: serp-win min|restore|focus|max|close [monitor|0xADDR]" >&2; exit 2 ;;
esac
