# EasyEffects в фоне — для эквалайзера и вкладки «Аудио» в окне музыки (верхняя панель).
# Окно музыки пишет настройки в пресет live_eq (third_party/.../media/equalizer.sh) и сам запускает
# эту службу, если EasyEffects не работает. Ставится scripts/setup-equalizer.sh.
[Unit]
Description=EasyEffects (эквалайзер Serpantinum)
PartOf=graphical-session.target
After=graphical-session.target pipewire.service pipewire-pulse.service wireplumber.service

[Service]
ExecStart=/usr/bin/easyeffects -w -l live_eq
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
